# ---------- Google (Ads + GA4 share one OAuth login) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=            # from scripts/get_google_refresh_token.py
GOOGLE_ADS_DEVELOPER_TOKEN=      # Google Ads > Tools > API Center (needs an MCC account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # your MCC id, digits only, if you access accounts through one

# ---------- Meta ----------
META_ACCESS_TOKEN=               # System User token from Business Settings (never expires)
META_API_VERSION=v24.0

# ---------- Safety ----------
ALLOW_WRITES=false               # true = allow confirmed changes to your accounts
MAX_DAILY_BUDGET=500             # hard cap on any daily budget the agent can set
ALLOWED_GOOGLE_ADS_CUSTOMERS=    # optional comma-separated allowlist, e.g. 1234567890,9876543210
ALLOWED_META_AD_ACCOUNTS=        # optional, e.g. act_123,act_456
AUDIT_LOG_PATH=audit_log.jsonl

# ---------- Remote HTTP server ----------
MCP_API_KEY=                     # long random string: python -c "import secrets;print(secrets.token_urlsafe(32))"
HOST=0.0.0.0
PORT=8000
